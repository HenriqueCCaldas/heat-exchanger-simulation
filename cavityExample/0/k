FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      k;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0.00375;

boundaryField
{
    tube_inlet
    {
        type            fixedValue;
        value           uniform 0.01; // Example value for k at inlet
    }
    tube_outlet
    {
        type            zeroGradient;
    }
    tube_wall
    {
        type            kqRWallFunction;
        value           uniform 0.00375;
    }
    shell_inlet
    {
        type            fixedValue;
        value           uniform 0.01; // Example value for k at inlet
    }
    shell_outlet
    {
        type            zeroGradient;
    }
    shell_wall
    {
        type            kqRWallFunction;
        value           uniform 0.00375;
    }
}


