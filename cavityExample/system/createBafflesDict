FoamFile
{
    format      ascii;
    class       dictionary;
    object      createBafflesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

internalFacesOnly true;

baffles
{
    tube_baffle
    {
        type        faceZones
        zoneName    tube_wall;

        owner
        {
            name        tube_to_shell;
            type        patch;
            neighbourRegion shell_fluid;
            neighbourPatch shell_to_fluid;
        }

        neighbour
        {
            name        shell_to_tube;
            type        patch;
            neighbourRegion tube_fluid;
            neighbourPatch tube_to_shell;
        }
    }
}


