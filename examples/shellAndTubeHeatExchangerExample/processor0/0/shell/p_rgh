FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/shell";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [ 1 -1 -2 0 0 0 0 ];

internalField   uniform 0;

boundaryField
{
    tube_inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    tube_outlet
    {
        type            fixedValue;
        value           $internalField;
    }
    tube_wall
    {
        type            fixedValue;
        value           $internalField;
    }
    shell_inlet
    {
        type            fixedValue;
        value           $internalField;
    }
    shell_outlet
    {
        type            fixedValue;
        value           $internalField;
    }
    shell_wall
    {
        type            fixedValue;
        value           $internalField;
    }
}

