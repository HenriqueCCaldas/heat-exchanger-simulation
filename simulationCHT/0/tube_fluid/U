FoamFile
{
    format      ascii;
    class       volVectorField;
    location    "0/tube_fluid";
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    tube_inlet
    {
        type            fixedValue;
        value           uniform (1 0 0);
    }
    tube_outlet
    {
        type            zeroGradient;
    }
    tube_fluid_to_shell_fluid
    {
        type            calculated;
        value           uniform (0 0 0);
    }
}


