FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/shell_fluid";
    object      p_rgh;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    shell_outlet
    {
        type            fixedValue;
        value           uniform 0;
    }
    shell_wall
    {
        type            calculated;
        value           uniform 0;
    }
    shell_inlet
    {
        type            fixedFluxPressure;
        gradient        uniform 0;
        value           uniform 0;
    }
    shell_fluid_to_tube_fluid
    {
        type            calculated;
        value           uniform 0;
    }
}


