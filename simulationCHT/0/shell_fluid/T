FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/shell_fluid";
    object      T;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 1 0 0 0];

internalField   uniform 300;

boundaryField
{
    shell_outlet
    {
        type            inletOutlet;
        inletValue      uniform 300;
        value           uniform 300;
    }
    shell_wall
    {
        type            zeroGradient;
    }
    shell_inlet
    {
        type            fixedValue;
        value           uniform 300;
    }
    shell_fluid_to_tube_fluid
    {
        type            calculated;
        value           uniform 0;
    }
}


