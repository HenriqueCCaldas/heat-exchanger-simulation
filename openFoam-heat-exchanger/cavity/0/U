FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{
    pipe_inlet
    {
        type            fixedValue;
        value           uniform (1 0 0);
    }

    shell_wall
    {
        type            noSlip;
    }

    pipe_outlet
    {
        type            empty;
    }
}

