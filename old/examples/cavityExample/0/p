FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -2 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    tube_inlet
    {
        type            zeroGradient;
    }
    
    tube_outlet
    {
        type            zeroGradient;
    }

    tube_wall
    {
        type            zeroGradient;
    }
    shell_inlet
    {
        type            zeroGradient;
    }
    
    shell_outlet
    {
        type            zeroGradient;
    }

    shell_wall
    {
        type            zeroGradient;
    }
}

