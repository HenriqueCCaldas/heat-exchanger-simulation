FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0/tube_fluid";
    object      alphat;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{
    tube_inlet
    {
        type            calculated;
        value           uniform 0;
    }
    tube_outlet
    {
        type            calculated;
        value           uniform 0;
    }
    tube_fluid_to_shell_fluid
    {
        type            calculated;
        value           uniform 0;
    }
}


